---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Reversedeer 的个人网站、博客与文档空间。' } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Reversedeer</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="brand-mark">R</span>
          <span>Reversedeer</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a class:list={{ active: pathname === '/' }} href="/">首页</a>
          <a class:list={{ active: pathname.startsWith('/blog') }} href="/blog/">博客</a>
          <a class:list={{ active: pathname.startsWith('/docs') }} href="/docs/">文档</a>
          <a class:list={{ active: pathname.startsWith('/projects') }} href="/projects/">项目</a>
          <a class:list={{ active: pathname.startsWith('/about') }} href="/about/">关于</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-wrap">
        <span>持续学习，持续记录。</span>
        <span>© {new Date().getFullYear()} Reversedeer</span>
      </div>
    </footer>
  </body>
</html>

