---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="首页">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">PERSONAL SPACE / 01</p>
      <h1>把正在做的事，<br /><em>慢慢写下来。</em></h1>
      <p class="hero-intro">这里是 Reversedeer。一个用于展示项目、记录思考、整理文档的个人空间。</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/blog/">阅读博客 <span>↗</span></a>
        <a class="button button-quiet" href="/docs/">浏览文档</a>
      </div>
    </div>
    <div class="hero-card" aria-label="网站状态">
      <div class="orb orb-large"></div>
      <div class="orb orb-small"></div>
      <div class="status-row"><span class="status-dot"></span> 静态优先，持续更新</div>
      <p class="hero-note">让内容保持轻盈，<br />让结构留有余地。</p>
      <span class="card-index">R / 2026</span>
    </div>
  </section>

  <section class="shell section-block">
    <div class="section-heading">
      <div><p class="eyebrow">EXPLORE / 02</p><h2>在这里找到什么</h2></div>
      <p>一个统一的入口，连接文章、文档与正在进行的项目。</p>
    </div>
    <div class="feature-grid">
      <a class="feature-card feature-dark" href="/blog/">
        <span class="feature-number">01</span><h3>博客</h3><p>记录开发过程、技术实践和那些值得回看的想法。</p><span class="feature-arrow">↗</span>
      </a>
      <a class="feature-card" href="/docs/">
        <span class="feature-number">02</span><h3>文档</h3><p>把零散的知识整理成可以快速查阅的结构。</p><span class="feature-arrow">↗</span>
      </a>
      <a class="feature-card" href="/projects/">
        <span class="feature-number">03</span><h3>项目</h3><p>展示正在构建的东西，以及它们背后的过程。</p><span class="feature-arrow">↗</span>
      </a>
    </div>
  </section>

  <section class="shell section-block latest-block">
    <div class="section-heading"><div><p class="eyebrow">LATEST / 03</p><h2>最近记录</h2></div><a class="text-link" href="/blog/">查看全部 →</a></div>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={`/blog/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          <span class="post-title">{post.data.title}</span>
          <span class="post-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

