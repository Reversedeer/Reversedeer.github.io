---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title} description={post.data.description}>
  <header class="article-header">
    <a class="back-link" href="/blog/">← 返回博客</a>
    <p class="eyebrow">JOURNAL / {post.data.pubDate.toLocaleDateString('zh-CN')}</p>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="article-summary">{post.data.description}</p>}
  </header>
  <div class="article-content prose"><Content /></div>
</BlogLayout>

