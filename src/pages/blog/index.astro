---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="博客" description="Reversedeer 的开发记录与个人思考。">
  <section class="shell page-intro compact-intro"><p class="eyebrow">JOURNAL / 06</p><h1>写下来的，<br /><em>才会留下。</em></h1></section>
  <section class="shell blog-index-list">
    {posts.map((post) => (
      <a class="blog-index-row" href={`/blog/${post.id}/`}>
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span>↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

